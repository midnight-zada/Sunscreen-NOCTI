{
  "expo": {
    "name": "Sunscreen-NOCTI",
    "slug": "Sunscreen-NOCTI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/placeholder.jpg",
    "scheme": "sunscreennocti",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/placeholder.jpg",
        "backgroundImage": "./assets/images/placeholder.jpg",
        "monochromeImage": "./assets/images/placeholder.jpg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/placeholder.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sunscreen-NOCTI to access your photos to set a profile picture.",
          "cameraPermission": "Allow Sunscreen-NOCTI to use your camera to take a profile picture."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
